      "updated": 1793725414745,
      "link": null,
      "locked": false,
      "text": "Make a field final if it should never change\nafter creation: IDs, createdAt, the user who\nplaced the order. Fewer things that can\nchange means fewer bugs.",
      "originalText": "Make a field final if it should never change\nafter creation: IDs, createdAt, the user who\nplaced the order. Fewer things that can\nchange means fewer bugs.",
      "fontSize": 25,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
