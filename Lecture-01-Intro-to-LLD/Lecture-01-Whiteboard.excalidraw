      "boundElements": [],
      "updated": 1793725414745,
      "link": null,
      "locked": false,
      "text": "Anyone could set any balance (even negative), skipping every check in addMoney and\npay. In a real app it would also skip the transaction history. Expose actions, not\nsetters.\nNote: throw stops the method and reports an error. Exceptions are covered properly in\nLecture 3.",
      "originalText": "Anyone could set any balance (even negative), skipping every check in addMoney and\npay. In a real app it would also skip the transaction history. Expose actions, not\nsetters.\nNote: throw stops the method and reports an error. Exceptions are covered properly in\nLecture 3.",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b31"
