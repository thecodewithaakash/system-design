      "isDeleted": false,
      "boundElements": [],
      "updated": 1793725414745,
      "link": null,
      "locked": false,
      "text": "class Wallet {\n    private double balance;\n\n    public double getBalance() {\n        return balance;\n    }\n\n    public void addMoney(double amount) {\n        if (amount <= 0)\n            throw new IllegalArgumentException(\"Bad amount\");\n        balance += amount;\n    }\n\n    public void pay(double amount) {\n        if (amount > balance)\n            throw new IllegalStateException(\"Low balance\");\n        balance -= amount;\n    }\n}",
      "originalText": "class Wallet {\n    private double balance;\n\n    public double getBalance() {\n        return balance;\n    }\n\n    public void addMoney(double amount) {\n        if (amount <= 0)\n            throw new IllegalArgumentException(\"Bad amount\");\n        balance += amount;\n    }\n\n    public void pay(double amount) {\n        if (amount > balance)\n            throw new IllegalStateException(\"Low balance\");\n        balance -= amount;\n    }\n}",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2v"
    },
