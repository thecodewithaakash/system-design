    {
      "id": "tex_340",
      "type": "text",
      "x": 28582,
      "y": 206.5,
      "width": 922.5,
      "height": 437.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
