      "versionNonce": 1643645193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793725414744,
      "link": null,
      "locked": false,
      "text": "• The class grows to hundreds of lines and keeps growing\n• Every new channel means editing the same old file\n• A bug in the WhatsApp code can break SMS too\n• Hard to test one channel on its own\n• Two developers editing it at the same time get merge conflicts\nPreview: in Lecture 12 (Strategy pattern) we fix this cleanly.",
      "originalText": "• The class grows to hundreds of lines and keeps growing\n• Every new channel means editing the same old file\n• A bug in the WhatsApp code can break SMS too\n• Hard to test one channel on its own\n• Two developers editing it at the same time get merge conflicts\nPreview: in Lecture 12 (Strategy pattern) we fix this cleanly.",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aS"
