  {
   "id": "tex_162",
   "type": "text",
   "x": 13382,
   "y": 1264.0,
   "width": 1836.8,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
