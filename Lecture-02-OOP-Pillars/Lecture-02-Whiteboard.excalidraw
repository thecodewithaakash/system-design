   "roundness": null,
   "seed": 1258,
   "version": 1,
   "versionNonce": 9962102,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "• Upcasting (child to parent): automatic and\n   always safe\n• Downcasting (parent to child): needs a cast and\n   can fail at runtime\n• Check with instanceof before you cast",
   "originalText": "• Upcasting (child to parent): automatic and\n   always safe\n• Downcasting (parent to child): needs a cast and\n   can fail at runtime\n• Check with instanceof before you cast",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
