  {
   "id": "tex_35",
   "type": "text",
   "x": 1982,
   "y": 1264.0,
   "width": 1882.7199999999998,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1035,
   "version": 1,
   "versionNonce": 8196165,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "• pay() gets a new branch for every method, and refund() needs its own copy of the\n   same if-else\n• The parameters keep growing: pay(method, amount, upiId, cardNumber, ...)\n• A typo like \"UPl\" compiles and silently does nothing\n• Blocking cash refunds depends on someone remembering to check\n• Every change edits code that already works, so old features can break",
   "originalText": "• pay() gets a new branch for every method, and refund() needs its own copy of the\n   same if-else\n• The parameters keep growing: pay(method, amount, upiId, cardNumber, ...)\n• A typo like \"UPl\" compiles and silently does nothing\n• Blocking cash refunds depends on someone remembering to check\n• Every change edits code that already works, so old features can break",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
