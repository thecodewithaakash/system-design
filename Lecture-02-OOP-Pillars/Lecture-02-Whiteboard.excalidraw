   "text": "class Checkout {\n    void pay(Payment payment) {\n        payment.pay();\n        System.out.println(payment.getReceipt());\n    }\n\n    void refund(Refundable payment) {\n        payment.refund();\n    }\n}",
   "originalText": "class Checkout {\n    void pay(Payment payment) {\n        payment.pay();\n        System.out.println(payment.getReceipt());\n    }\n\n    void refund(Refundable payment) {\n        payment.refund();\n    }\n}",
