   "text": "interface Refundable {\n    void refund();\n}\n\nclass UpiPayment extends Payment\n        implements Refundable {\n\n    @Override\n    public void refund() {\n        System.out.println(\"Refunded Rs \" + amount);\n    }\n}\n\nclass CashOnDelivery extends Payment {\n    // no refund(), and that's correct\n}",
