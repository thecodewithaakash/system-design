   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "class Order {\n    private final List<MenuItem> items\n            = new ArrayList<MenuItem>();\n\n    void addItem(MenuItem item) {\n        if (items.size() == 20)\n            throw new IllegalStateException();\n        items.add(item);\n    }\n\n    List<MenuItem> getItems() {\n        return items;\n    }\n}",
   "originalText": "class Order {\n    private final List<MenuItem> items\n            = new ArrayList<MenuItem>();\n\n    void addItem(MenuItem item) {\n        if (items.size() == 20)\n            throw new IllegalStateException();\n        items.add(item);\n    }\n\n    List<MenuItem> getItems() {\n        return items;\n    }\n}",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
