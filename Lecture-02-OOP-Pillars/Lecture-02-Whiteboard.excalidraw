   "roundness": null,
   "seed": 1032,
   "version": 1,
   "versionNonce": 8172408,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Every request lands in the same method. The four OOP pillars are the tools that stop\nthis. By the end of today, a new payment method will mean a new file, not an edit.",
   "originalText": "Every request lands in the same method. The four OOP pillars are the tools that stop\nthis. By the end of today, a new payment method will mean a new file, not an edit.",
   "fontSize": 27,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
