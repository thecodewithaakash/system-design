  {
   "id": "tex_258",
   "type": "text",
   "x": 21782,
   "y": 394.5,
   "width": 843.78,
   "height": 131.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
