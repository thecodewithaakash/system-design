   "text": "class Checkout {\n\n    void pay(String method, double amount) {\n        if (method.equals(\"UPI\")) {\n            // 15 lines of UPI logic\n        } else if (method.equals(\"CARD\")) {\n            // 15 lines of card logic\n        } else if (method.equals(\"CASH\")) {\n            // 5 lines: collect at the door\n        }\n    }\n}",
   "originalText": "class Checkout {\n\n    void pay(String method, double amount) {\n        if (method.equals(\"UPI\")) {\n            // 15 lines of UPI logic\n        } else if (method.equals(\"CARD\")) {\n            // 15 lines of card logic\n        } else if (method.equals(\"CASH\")) {\n            // 5 lines: collect at the door\n        }\n    }\n}",
