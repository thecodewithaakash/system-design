   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "class Payment {\n    protected final double amount;\n\n    Payment(double amount) {\n        this.amount = amount;\n    }\n}\n\nclass UpiPayment extends Payment {\n    private final String upiId;\n\n    UpiPayment(double amount, String upiId) {\n        super(amount);      // parent part first\n        this.upiId = upiId;\n    }\n}",
   "originalText": "class Payment {\n    protected final double amount;\n\n    Payment(double amount) {\n        this.amount = amount;\n    }\n}\n\nclass UpiPayment extends Payment {\n    private final String upiId;\n\n    UpiPayment(double amount, String upiId) {\n        super(amount);      // parent part first\n        this.upiId = upiId;\n    }\n}",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
