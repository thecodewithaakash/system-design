   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "• Same name and parameters, matching return type\n• @Override asks the compiler to check that you really\n   are overriding\n• You can't make it less visible (public in the parent\n   stays public)\n• super.pay() still runs the parent's version if you\n   need it",
   "originalText": "• Same name and parameters, matching return type\n• @Override asks the compiler to check that you really\n   are overriding\n• You can't make it less visible (public in the parent\n   stays public)\n• super.pay() still runs the parent's version if you\n   need it",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
