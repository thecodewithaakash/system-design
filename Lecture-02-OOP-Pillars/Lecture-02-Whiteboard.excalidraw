   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Inheritance",
   "originalText": "Inheritance",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex_47",
   "type": "text",
   "x": 4634,
   "y": 239.0,
   "width": 396.06,
   "height": 288.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame_02",
   "roundness": null,
   "seed": 1047,
   "version": 1,
   "versionNonce": 8291193,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Every car model starts\nfrom the same base\ndesign and adds its own\nfeatures.\n\nIn code: extends and\nsuper.\n\nCheckout: shared code\nlike the receipt is\nwritten once.",
   "originalText": "Every car model starts\nfrom the same base\ndesign and adds its own\nfeatures.\n\nIn code: extends and\nsuper.\n\nCheckout: shared code\nlike the receipt is\nwritten once.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec_48",
   "type": "rectangle",
   "x": 4988,
   "y": 170,
   "width": 350,
   "height": 470,
   "angle": 0,
