   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Prints 'Generic receipt'. The overload is chosen at compile time from the variable's\ntype, and p is declared as Payment. Overriding is chosen at runtime from the object.\nIf behaviour should follow the object, put it in the object as an overridden method.",
   "originalText": "Prints 'Generic receipt'. The overload is chosen at compile time from the variable's\ntype, and p is declared as Payment. Overriding is chosen at runtime from the object.\nIf behaviour should follow the object, put it in the object as an overridden method.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
