   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Payment is an abstract class: every payment has an amount and a\nreceipt. Refundable is an interface: an order cancellation or a\nsubscription could be refundable too.",
   "originalText": "Payment is an abstract class: every payment has an amount and a\nreceipt. Refundable is an interface: an order cancellation or a\nsubscription could be refundable too.",
