   "text": "class Payment {\n    void pay() {\n        System.out.println(\"Paying Rs \" + amount);\n    }\n}\n\nclass UpiPayment extends Payment {\n    @Override\n    void pay() {\n        System.out.println(\"Paid Rs \" + amount\n                + \" using UPI \" + upiId);\n    }\n}",
   "originalText": "class Payment {\n    void pay() {\n        System.out.println(\"Paying Rs \" + amount);\n    }\n}\n\nclass UpiPayment extends Payment {\n    @Override\n    void pay() {\n        System.out.println(\"Paid Rs \" + amount\n                + \" using UPI \" + upiId);\n    }\n}",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
