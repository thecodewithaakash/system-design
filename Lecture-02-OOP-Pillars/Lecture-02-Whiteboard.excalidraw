   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Encapsulation hides the DATA, to protect it. Abstraction hides the DETAILS of how something\nworks, to make it simple to use.",
