   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "(a) Yes: a UPI payment IS A payment.   (b) No: an order HAS menu items.\n(c) No: a car HAS an engine.   (d) Yes: a delivery partner IS A user of the app.\nIf 'is a' sounds wrong when you say it out loud, don't use extends. HAS-A comes in\nLecture 3.",
   "originalText": "(a) Yes: a UPI payment IS A payment.   (b) No: an order HAS menu items.\n(c) No: a car HAS an engine.   (d) Yes: a delivery partner IS A user of the app.\nIf 'is a' sounds wrong when you say it out loud, don't use extends. HAS-A comes in\nLecture 3.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
