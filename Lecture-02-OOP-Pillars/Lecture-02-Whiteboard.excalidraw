   "version": 1,
   "versionNonce": 9890831,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "List<Payment> payments = List.of(\n        new UpiPayment(410, \"rahul@okaxis\"),\n        new CardPayment(250, \"4111111111114242\"),\n        new CashOnDelivery(180));\n\nfor (Payment p : payments) {\n    p.pay();\n    System.out.println(p.getReceipt());\n}\n// No if-else. New payment types need no change here.",
   "originalText": "List<Payment> payments = List.of(\n        new UpiPayment(410, \"rahul@okaxis\"),\n        new CardPayment(250, \"4111111111114242\"),\n        new CashOnDelivery(180));\n\nfor (Payment p : payments) {\n    p.pay();\n    System.out.println(p.getReceipt());\n}\n// No if-else. New payment types need no change here.",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
