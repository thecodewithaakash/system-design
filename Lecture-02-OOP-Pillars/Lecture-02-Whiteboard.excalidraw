   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Prints 0.0. getItems() returned the real list, not a copy, so clearing it emptied the\norder. The same trick lets anyone add 50 items and skip the 20 item check. A private\nfield is not enough if the getter hands it out.",
   "originalText": "Prints 0.0. getItems() returned the real list, not a copy, so clearing it emptied the\norder. The same trick lets anyone add 50 items and skip the 20 item check. A private\nfield is not enough if the getter hands it out.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
