   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Encapsulation",
   "originalText": "Encapsulation",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex_41",
   "type": "text",
   "x": 3882,
   "y": 239.0,
   "width": 413.28,
   "height": 288.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame_02",
   "roundness": null,
   "seed": 1041,
   "version": 1,
   "versionNonce": 8243679,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "The engine is sealed.\nYou can't reach in and\nturn the gears yourself.\n\nIn code: private data,\nchanged only through\nmethods.\n\nCheckout: each payment\nkeeps its own details\nprivate.",
   "originalText": "The engine is sealed.\nYou can't reach in and\nturn the gears yourself.\n\nIn code: private data,\nchanged only through\nmethods.\n\nCheckout: each payment\nkeeps its own details\nprivate.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
