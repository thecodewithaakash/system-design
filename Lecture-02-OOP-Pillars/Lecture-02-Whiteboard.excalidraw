   "text": "abstract class Payment {\n    protected final double amount;\n\n    Payment(double amount) {\n        this.amount = amount;\n    }\n\n    abstract void pay();   // no body\n\n    final String getReceipt() {\n        return \"Receipt: Rs \" + amount + \" paid\";\n    }\n}",
   "originalText": "abstract class Payment {\n    protected final double amount;\n\n    Payment(double amount) {\n        this.amount = amount;\n    }\n\n    abstract void pay();   // no body\n\n    final String getReceipt() {\n        return \"Receipt: Rs \" + amount + \" paid\";\n    }\n}",
   "fontSize": 19,
   "fontFamily": 3,
