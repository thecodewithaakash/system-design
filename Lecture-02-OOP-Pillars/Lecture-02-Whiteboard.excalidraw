   "text": "class Payment {\n    String getDetails() {\n        return \"Generic payment\";\n    }\n}\n\nclass CardPayment extends Payment {\n    String getDetail() {\n        return \"Card ending 4242\";\n    }\n}\n\nCardPayment card = new CardPayment();\nSystem.out.println(card.getDetails());",
   "originalText": "class Payment {\n    String getDetails() {\n        return \"Generic payment\";\n    }\n}\n\nclass CardPayment extends Payment {\n    String getDetail() {\n        return \"Card ending 4242\";\n    }\n}\n\nCardPayment card = new CardPayment();\nSystem.out.println(card.getDetails());",
   "fontSize": 19,
